{
  "name": "webmarket",
  "private": true,
  "description": "Marketplace where local business owners search their name, preview a website already built for them, and buy it.",
  "type": "module",
  "scripts": {
    "build": "python3 scripts/build.py",
    "dev": "python3 scripts/build.py && python3 -m http.server 8080 --directory public",
    "test": "npm run test:js && npm run test:py",
    "test:js": "node --test \"tests/unit/*.test.js\" \"tests/api/*.test.js\"",
    "test:py": "python3 -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "nodemailer": "^6.9.0",
    "stripe": "^16.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
